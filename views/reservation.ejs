<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reserve a Table — Reservia</title>
    <link rel="shortcut icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2L15.5 8.5L22 12L15.5 15.5L12 22L8.5 15.5L2 12L8.5 8.5L12 2Z" fill="%23c8a97e"/></svg>' type="image/svg+xml">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <%- include("includes/styles.ejs") %>
    <%- include("includes/reservation.ejs") %>
</head>
<body>
    <%- include("includes/header.ejs", { image: images }) %>

    <!-- Hero Banner -->
    <section class="res-hero">
        <div class="res-hero-overlay"></div>
        <div class="res-hero-content" data-aos="fade-up">
            <p class="res-hero-sub">Reserve. Relax. Rejoice.</p>
            <h1 class="res-hero-title">Book Your Table</h1>
            <div class="res-hero-divider">
                <span></span><div class="res-diamond"></div><span></span>
            </div>
        </div>
    </section>

    <!-- Reservation Form -->
    <section class="res-section" data-aos="fade-up" data-aos-delay="100">
        <div class="res-container">
            <form id="reservationForm" class="res-form" action="/reservation" method="POST">

                <% if (typeof error !== 'undefined' && error) { %>
                <div style="background:rgba(220,50,50,0.1);border:1px solid rgba(220,50,50,0.35);color:#ff8080;padding:14px 18px;font-family:'DM Sans',sans-serif;font-size:1.4rem;margin-bottom:28px;border-radius:2px;">
                    ⚠ <%= error %>
                </div>
                <% } %>

                <div class="res-form-grid">
                    <div class="res-form-group">
                        <label class="res-label">Full Name</label>
                        <input class="res-input" type="text" name="name" required placeholder="Your full name">
                    </div>

                    <div class="res-form-group">
                        <label class="res-label">Email Address</label>
                        <input class="res-input" type="email" name="email" required placeholder="your@email.com">
                    </div>

                    <div class="res-form-group">
                        <label class="res-label">Phone / WhatsApp <span style="opacity:0.6;font-size:0.85em;">(India)</span></label>
                        <div style="display: flex; align-items: center; border-bottom: 1px solid rgba(166,123,91,0.25);">
                            <span style="font-family:'DM Sans', sans-serif; font-size:1.5rem; color:hsl(42,48%,77%); padding:12px 10px 12px 0; font-weight:600; border-right:1px solid rgba(166,123,91,0.2); margin-right:10px; white-space:nowrap;">🇮🇳 +91</span>
                            <input class="res-input" style="border:none; padding:12px 0;" type="tel" name="phone" id="phone-input" required placeholder="98765 43210" pattern="[0-9]{10}" maxlength="10" title="Please enter a 10-digit Indian mobile number">
                        </div>
                    </div>

                    <div class="res-form-group">
                        <label class="res-label">Date</label>
                        <input class="res-input" type="date" name="date" id="date-input" required>
                    </div>

                    <div class="res-form-group">
                        <label class="res-label">Time <span style="opacity:0.6;font-size:0.85em;">(Pick any time)</span></label>
                        <input class="res-input" type="time" name="time" id="time-input" required style="color-scheme: dark; cursor: pointer;" list="dining-times" value="19:30">
                        <datalist id="dining-times">
                            <option value="11:30">11:30 AM (Lunch)</option>
                            <option value="12:00">12:00 PM</option>
                            <option value="12:30">12:30 PM</option>
                            <option value="13:00">1:00 PM</option>
                            <option value="13:30">1:30 PM</option>
                            <option value="14:00">2:00 PM</option>
                            <option value="14:30">2:30 PM</option>
                            <option value="17:00">5:00 PM (High Tea / Early Dinner)</option>
                            <option value="17:30">5:30 PM</option>
                            <option value="18:00">6:00 PM</option>
                            <option value="18:30">6:30 PM</option>
                            <option value="19:00">7:00 PM</option>
                            <option value="19:30">7:30 PM</option>
                            <option value="20:00">8:00 PM (Prime Dinner)</option>
                            <option value="20:30">8:30 PM</option>
                            <option value="21:00">9:00 PM</option>
                            <option value="21:30">9:30 PM</option>
                            <option value="22:00">10:00 PM (Late Dinner)</option>
                            <option value="22:30">10:30 PM</option>
                            <option value="23:00">11:00 PM</option>
                        </datalist>
                    </div>

                    <div class="res-form-group">
                        <label class="res-label">Number of Guests</label>
                        <select class="res-input" name="guests" required>
                            <option value="" disabled selected>Select guests</option>
                            <option value="1">1 Person</option>
                            <option value="2">2 People</option>
                            <option value="3">3 People</option>
                            <option value="4">4 People</option>
                            <option value="5">5 People</option>
                            <option value="6">6+ People</option>
                        </select>
                    </div>

                    <div class="res-form-group">
                        <label class="res-label">Ambiance</label>
                        <select class="res-input" name="music" required>
                            <option value="" disabled selected>Select ambiance</option>
                            <option value="jazz">Smooth Jazz</option>
                            <option value="classical">Classical Symphony</option>
                            <option value="acoustic">Acoustic Melodies</option>
                            <option value="ambient">Ambient Sounds</option>
                            <option value="none">No Preference</option>
                        </select>
                    </div>
                </div>

                <div class="res-form-group">
                    <label class="res-label">Choose Your Restaurant</label>
                    <select class="res-input" name="restaurant" required>
                        <option value="" disabled selected>Select a restaurant</option>
                        <option value="The Spice Symphony">The Spice Symphony</option>
                        <option value="Oceanic Bliss">Oceanic Bliss</option>
                        <option value="Skyline Grill">Skyline Grill</option>
                        <option value="Vintage Bites">Vintage Bites</option>
                    </select>
                </div>

                <div class="res-form-group">
                    <label class="res-label">Special Requests <span style="opacity:0.4">(Optional)</span></label>
                    <textarea class="res-input res-textarea" name="requests" placeholder="Any dietary requirements, occasion details, seating preferences..."></textarea>
                </div>

                <button type="submit" class="res-submit-btn">
                    <span>Complete Reservation</span>
                </button>
            </form>
        </div>
    </section>

    <%- include("includes/footer.ejs", { image: images }) %>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script>
        AOS.init({ duration: 900, once: true });
        // Set minimum date to today
        document.getElementById('date-input').min = new Date().toISOString().split('T')[0];
    </script>
</body>
</html>
