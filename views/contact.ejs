<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us — Reservia</title>
    <%- include("includes/styles.ejs") %>
    <style>
        .contact-page {
            min-height: 100vh;
            background: #0d0d0d;
            background-image: radial-gradient(ellipse at center, rgba(166,123,91,0.15) 0%, transparent 70%);
            padding: 180px 24px 100px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .contact-wrapper {
            max-width: 1100px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr;
            gap: 60px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(166,123,91,0.2);
            padding: 60px;
            border-radius: 4px;
            animation: fadeSlideUp 0.6s ease forwards;
        }

        @media(min-width: 992px) {
            .contact-wrapper { grid-template-columns: 1fr 1fr; }
        }

        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .contact-info h1 {
            font-family: 'Forum', cursive;
            font-size: 4rem;
            color: hsl(42, 48%, 77%);
            margin-bottom: 20px;
            line-height: 1;
        }

        .contact-info p {
            font-family: 'DM Sans', sans-serif;
            font-size: 1.1rem;
            color: rgba(255,255,255,0.6);
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .info-item {
            margin-bottom: 30px;
        }

        .info-item h3 {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: hsl(42, 48%, 77%);
            margin-bottom: 8px;
        }

        .info-item p {
            font-family: 'Forum', cursive;
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 0;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .c-input {
            width: 100%;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(166,123,91,0.3);
            padding: 16px 20px;
            font-family: 'DM Sans', sans-serif;
            font-size: 1.2rem;
            color: #fff;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .c-input:focus {
            outline: none;
            border-color: hsl(42, 48%, 77%);
            background: rgba(255,255,255,0.06);
        }

        textarea.c-input {
            resize: none;
            height: 150px;
        }

        .c-btn {
            background: transparent;
            border: 1px solid hsl(42, 48%, 77%);
            color: hsl(42, 48%, 77%);
            padding: 16px;
            font-family: 'DM Sans', sans-serif;
            font-size: 1.1rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .c-btn:hover {
            background: hsl(42, 48%, 77%);
            color: #1a1008;
        }

        #success-msg {
            display: none;
            background: rgba(40,167,69,0.15);
            border: 1px solid rgba(74,222,128,0.3);
            color: #4ade80;
            padding: 16px;
            font-family: 'DM Sans', sans-serif;
            font-size: 1.1rem;
            border-radius: 2px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <%- include("includes/header.ejs", { image: images }) %>

    <div class="contact-page">
        <div class="contact-wrapper">
            <div class="contact-info">
                <h1>Get in Touch</h1>
                <p>Reach out to us for private dining inquiries, special events, or any other questions. Our concierge team is at your service.</p>
                
                <div class="info-item">
                    <h3>Location</h3>
                    <p>123 Culinary Avenue, Food City</p>
                </div>
                
                <div class="info-item">
                    <h3>Reservations</h3>
                    <p>+91 98765 43210</p>
                </div>

                <div class="info-item">
                    <h3>Email</h3>
                    <p>concierge@reservia.com</p>
                </div>

                <div class="info-item">
                    <h3>Operating Hours</h3>
                    <p>Lunch: 12:00 PM – 3:30 PM<br>Dinner: 6:30 PM – 11:00 PM</p>
                </div>
            </div>

            <form class="contact-form" id="contactForm">
                <div id="success-msg">✓ Your message has been sent to our concierge. We will reply shortly.</div>
                
                <input type="text" class="c-input" placeholder="Your Name" required>
                <input type="email" class="c-input" placeholder="Your Email Address" required>
                <input type="tel" class="c-input" placeholder="Phone Number" required>
                <textarea class="c-input" placeholder="How can we help you?" required></textarea>
                
                <button type="submit" class="c-btn">Send Message</button>
            </form>
        </div>
    </div>

    <%- include("includes/footer.ejs") %>
    
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script>
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            this.reset();
            const msg = document.getElementById('success-msg');
            msg.style.display = 'block';
            setTimeout(() => { msg.style.display = 'none'; }, 5000);
        });
    </script>
</body>
</html>
