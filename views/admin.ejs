<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — Reservia</title>
    <%- include("includes/styles.ejs") %>
    <style>
        .admin-page {
            min-height: 100vh;
            background: #0d0d0d;
            background-image: radial-gradient(ellipse at top right, rgba(166,123,91,0.1) 0%, transparent 50%);
            padding: 140px 24px 100px;
            font-family: 'DM Sans', sans-serif;
            color: #fff;
        }

        .admin-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 20px;
        }

        .admin-header h1 {
            font-family: 'Forum', cursive;
            font-size: 3.5rem;
            color: hsl(42, 48%, 77%);
            margin: 0;
            line-height: 1;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
            margin-bottom: 50px;
        }

        .stat-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(166,123,91,0.2);
            padding: 30px;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s, border-color 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: hsl(42, 48%, 77%);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 4px;
            height: 100%;
            background: hsl(42, 48%, 77%);
        }

        .stat-label {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255,255,255,0.5);
            margin-bottom: 10px;
            display: block;
        }

        .stat-value {
            font-family: 'Forum', cursive;
            font-size: 3rem;
            color: #fff;
            line-height: 1;
        }

        .table-container {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 4px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 16px 24px;
            text-align: left;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        th {
            background: rgba(255,255,255,0.05);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: hsl(42, 48%, 77%);
        }

        td {
            font-size: 1rem;
            color: rgba(255,255,255,0.8);
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: bold;
        }

        .status-reserved {
            background: rgba(40,167,69,0.15);
            color: #4ade80;
            border: 1px solid rgba(74,222,128,0.3);
        }

        .status-completed {
            background: rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.6);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .status-noshow {
            background: rgba(239,68,68,0.15);
            color: #f87171;
            border: 1px solid rgba(248,113,113,0.3);
        }

        .status-cancelled {
            background: rgba(156,163,175,0.15);
            color: #9ca3af;
            border: 1px solid rgba(156,163,175,0.3);
        }

        .btn-action {
            padding: 5px 12px;
            font-size: 0.8rem;
            border-radius: 3px;
            cursor: pointer;
            border: none;
            font-family: inherit;
            font-weight: 600;
            transition: opacity 0.2s, transform 0.1s;
            margin-right: 6px;
        }

        .btn-action:hover { opacity: 0.85; transform: scale(1.02); }
        .btn-seat { background: #22c55e; color: #000; }
        .btn-noshow { background: #ef4444; color: #fff; }
        .btn-ping { background: #25d366; color: #000; }
    </style>
</head>
<body>
    <%- include("includes/header.ejs", { image: images }) %>

    <div class="admin-page">
        <div class="admin-container">
            <div class="admin-header">
                <div>
                    <h1>Command Center</h1>
                    <p style="color: rgba(255,255,255,0.5); margin-top: 10px;">Restaurant Management Dashboard</p>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">Total Revenue</span>
                    <span class="stat-value">₹<%= totalRevenue.toLocaleString('en-IN') %></span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Total Bookings</span>
                    <span class="stat-value"><%= totalReservations %></span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Registered Users</span>
                    <span class="stat-value"><%= totalUsers %></span>
                </div>
            </div>

            <h2 style="font-family: 'Forum', cursive; font-size: 2rem; margin-bottom: 20px; color: #fff;">Recent Reservations</h2>
            
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Guest & Contact</th>
                            <th>Restaurant & Table</th>
                            <th>Date & Time</th>
                            <th>Party</th>
                            <th>Status & Confirmation</th>
                            <th>Floor Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(recentReservations.length > 0) { %>
                            <% recentReservations.forEach(res => { %>
                                <tr id="row-<%= res._id %>">
                                    <td>
                                        <strong><%= res.name %></strong><br>
                                        <small style="opacity:0.7;"><%= res.phone || res.email %></small>
                                    </td>
                                    <td>
                                        <%= res.restaurant %><br>
                                        <span style="font-size:0.8rem; color:hsl(42, 48%, 77%); font-weight:600;">Table #<%= res.tableNumber || 1 %></span>
                                    </td>
                                    <td><%= res.date %><br><small style="opacity:0.7;"><%= res.time %></small></td>
                                    <td><%= res.guests %> Guests</td>
                                    <td>
                                        <% let badgeClass = 'status-reserved';
                                           if (res.status === 'Completed') badgeClass = 'status-completed';
                                           else if (res.status === 'No-Show') badgeClass = 'status-noshow';
                                           else if (res.status === 'Cancelled') badgeClass = 'status-cancelled';
                                        %>
                                        <span class="status-badge <%= badgeClass %>">
                                            <%= res.status || 'Reserved' %>
                                        </span>
                                        <div style="margin-top:6px; font-size:0.78rem;">
                                            <% if (res.isConfirmed) { %>
                                                <span style="color:#4ade80;">✓ Confirmed</span>
                                            <% } else { %>
                                                <span style="color:#facc15;">⏳ Pending Ping</span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (res.status === 'Reserved') { %>
                                            <button onclick="updateStatus('<%= res._id %>', 'Completed')" class="btn-action btn-seat" title="Mark guest seated">Seat</button>
                                            <button onclick="updateStatus('<%= res._id %>', 'No-Show')" class="btn-action btn-noshow" title="Mark no-show & free table">No-Show</button>
                                            <button onclick="sendPing('<%= res._id %>', '<%= res.phone || '' %>', '<%= res.name || '' %>', '<%= res.restaurant || '' %>', '<%= res.time || '' %>', '<%= res.guests || 1 %>')" class="btn-action btn-ping" title="Send WhatsApp confirmation ping">📲 Ping</button>
                                        <% } else { %>
                                            <span style="opacity:0.5; font-size:0.85rem;">Completed</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.4);">
                                    No reservations found in the database.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include("includes/footer.ejs") %>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <script>
        async function updateStatus(id, status) {
            const confirmMsg = status === 'No-Show' 
                ? "Mark as No-Show? This will immediately free Table slot for walk-in guests." 
                : "Mark guest as Seated / Completed?";
            if (!confirm(confirmMsg)) return;

            try {
                const res = await fetch(`/admin/reservation/${id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ status })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to update.");
                }
            } catch (err) {
                alert("Network error.");
            }
        }

        async function sendPing(id, rawPhone, name, restaurant, time, guests) {
            // 1. Format Indian WhatsApp number
            let digits = (rawPhone || "").replace(/\D/g, "");
            if (digits.length === 10) {
                digits = "91" + digits; // prepend Indian country code
            }

            if (!digits) {
                alert("Cannot ping: No phone number was provided for this reservation.");
                return;
            }

            // 2. Prepare pre-filled WhatsApp message
            const message = `Hello ${name}! ✦\n\nThis is Reservia confirming your table reservation for ${guests} guests at *${restaurant}* for *${time}*.\n\nPlease reply with:\n👉 *1* or *CONFIRM* to confirm arrival\n👉 *2* or *CANCEL* to release your table without penalty.`;

            // 3. Open WhatsApp Web / App directly
            const waUrl = `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
            window.open(waUrl, '_blank');

            // 4. Also notify backend to log and mark confirmationSent: true
            try {
                fetch(`/admin/reservation/${id}/ping-whatsapp`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json' }
                }).catch(() => {});
            } catch (e) {}
        }
    </script>
</body>
</html>
