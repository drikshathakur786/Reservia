<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservia — Create Account</title>
    <link rel="shortcut icon" href="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSU5zQzIc0nbzV04ns-mz3q7PwWJUYHLyHyQA&s" type="image/x-icon">
    <%- include("includes/styles.ejs") %>
    <%- include("includes/login.ejs") %>
</head>
<body>
    <%- include("includes/header.ejs", { image: images }) %>

    <div class="auth-page">
        <div class="auth-card">

            <div class="auth-brand">
                <div class="r-badge">R</div>
                <h1>Join Reservia</h1>
                <p>Your table awaits</p>
            </div>

            <div class="auth-divider">
                <span></span><div class="diamond"></div><span></span>
            </div>

            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="auth-error">⚠ <%= errors[0].msg %></div>
            <% } %>

            <form action="/sign-up" method="POST" id="signup-form">
                <label class="auth-label">Full Name</label>
                <input class="auth-input" type="text" name="name" required placeholder="Your full name" autocomplete="name">

                <label class="auth-label">Email Address</label>
                <input class="auth-input" type="email" name="email" required placeholder="your@email.com" autocomplete="email">

                <label class="auth-label">Password</label>
                <input class="auth-input" type="password" name="password" id="password" required placeholder="Min. 6 characters" autocomplete="new-password">

                <label class="auth-label">Confirm Password</label>
                <input class="auth-input" type="password" id="confirm-password" required placeholder="Repeat your password" autocomplete="new-password">

                <div id="pw-error" class="auth-error" style="display:none;">⚠ Passwords do not match.</div>

                <button type="submit" class="auth-btn"><span>Create Account</span></button>
            </form>

            <p class="auth-footer">
                Already have an account? <a href="/login">Log in</a>
            </p>
        </div>
    </div>

    <%- include("includes/footer.ejs") %>

    <script>
        // Client-side password match check
        document.getElementById('signup-form').addEventListener('submit', function(e) {
            const pw = document.getElementById('password').value;
            const cpw = document.getElementById('confirm-password').value;
            const err = document.getElementById('pw-error');
            if (pw !== cpw) {
                e.preventDefault();
                err.style.display = 'flex';
            } else {
                err.style.display = 'none';
            }
        });

        // Also handle JSON response from server for signup
        document.getElementById('signup-form').addEventListener('submit', async function(e) {
            // Only intercept if passwords matched (default form submit otherwise)
        });
    </script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</body>
</html>
