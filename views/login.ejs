<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservia — Login</title>
    <link rel="shortcut icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2L15.5 8.5L22 12L15.5 15.5L12 22L8.5 15.5L2 12L8.5 8.5L12 2Z" fill="%23c8a97e"/></svg>' type="image/svg+xml">
    <%- include("includes/styles.ejs") %>
    <%- include("includes/login.ejs") %>
</head>
<body>
    <%- include("includes/header.ejs", { image: images }) %>

    <div class="auth-page">
        <div class="auth-card">

            <div class="auth-brand">
                <div class="r-badge">R</div>
                <h1>Welcome Back</h1>
                <p>Reserve. Relax. Rejoice.</p>
            </div>

            <div class="auth-divider">
                <span></span><div class="diamond"></div><span></span>
            </div>

            <% if (message) { %>
                <div class="auth-error">⚠ <%= message %></div>
            <% } %>

            <form method="POST" action="/login">
                <label class="auth-label">Email Address</label>
                <input class="auth-input" type="email" name="username" required placeholder="your@email.com" autocomplete="email">

                <label class="auth-label">Password</label>
                <input class="auth-input" type="password" name="password" required placeholder="••••••••" autocomplete="current-password">

                <button type="submit" class="auth-btn"><span>Enter Reservia</span></button>
            </form>

            <p class="auth-footer">
                New here? <a href="/sign-up">Create an account</a>
            </p>
        </div>
    </div>

    <%- include("includes/footer.ejs") %>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</body>
</html>
