    border-radius: 4px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: 0 8px 30px rgba(0,0,0,0.8), 0 0 15px rgba(201,160,80,0.25);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

#ai-concierge-toggle:hover {
    background: hsl(42, 48%, 77%);
    color: #1a1008;
    border-color: hsl(42, 48%, 77%);
