    fill: #1a1008;
}

.ai-pulse-ring {
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    border: 1px solid rgba(201,160,80,0.4);
    border-radius: 6px;
    animation: ai-pulse 2.8s infinite;
    pointer-events: none;
}

@keyframes ai-pulse {
    0% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.06); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
}

/* Chat Modal Window */
#ai-concierge-modal {
    position: fixed;
    bottom: 90px;
    right: 28px;
    width: 440px;
    max-width: calc(100vw - 36px);
    height: 600px;
    max-height: calc(100vh - 120px);
    background: linear-gradient(180deg, #18120b 0%, #100b07 100%);
    border: 1px solid rgba(201, 160, 80, 0.45);
    border-radius: 8px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.95), 0 0 35px rgba(201, 160, 80, 0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.ai-modal-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(24px) scale(0.95);
    display: none !important;
}

/* Header */
.ai-header {
    background: #1c140c;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(201, 160, 80, 0.25);
}

.ai-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.ai-avatar {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: #251b11;
    border: 1px solid rgba(201, 160, 80, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
}

.ai-brand-titles {
    display: flex;
    flex-direction: column;
}

.ai-brand-name {
    font-family: 'Forum', cursive;
    font-size: 1.45rem;
    color: #fff;
    letter-spacing: 0.15em;
    line-height: 1;
    margin-bottom: 4px;
}

.ai-brand-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    color: hsl(42, 48%, 77%);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: 6px;
}

.ai-live-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    display: inline-block;
}

#ai-concierge-close {
    background: transparent;
    border: none;
    color: hsl(42, 48%, 77%);
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    padding: 4px;
    transition: color 0.2s, transform 0.2s;
}

#ai-concierge-close:hover {
    color: #fff;
    transform: scale(1.1);
}

/* Suggestion Chips */
.ai-chips-wrapper {
    display: flex;
    gap: 8px;
    padding: 12px 18px;
    overflow-x: auto;
    background: #140e08;
    border-bottom: 1px solid rgba(201, 160, 80, 0.15);
    scrollbar-width: none;
}

.ai-chips-wrapper::-webkit-scrollbar {
    display: none;
}

.ai-chip {
    flex-shrink: 0;
    background: #23190f;
    border: 1px solid rgba(201, 160, 80, 0.35);
    color: hsl(42, 48%, 77%);
    padding: 6px 14px;
    border-radius: 3px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}

.ai-chip:hover {
    background: hsl(42, 48%, 77%);
    color: #1a1008;
    border-color: hsl(42, 48%, 77%);
}

/* Messages Container with Custom Luxury Scrollbar */
.ai-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.ai-messages::-webkit-scrollbar {
    width: 6px;
}

.ai-messages::-webkit-scrollbar-track {
    background: #100b07;
}

.ai-messages::-webkit-scrollbar-thumb {
    background: rgba(201, 160, 80, 0.4);
    border-radius: 3px;
}

.ai-messages::-webkit-scrollbar-thumb:hover {
    background: hsl(42, 48%, 77%);
}

.ai-msg {
    display: flex;
    flex-direction: column;
    max-width: 90%;
}

.ai-msg-bot {
    align-self: flex-start;
}

.ai-msg-user {
    align-self: flex-end;
}

.ai-msg-bubble {
    padding: 14px 18px;
    border-radius: 4px;
    font-size: 1.02rem;
    line-height: 1.7;
    word-break: break-word;
    font-family: 'DM Sans', sans-serif;
}

.ai-msg-bot .ai-msg-bubble {
    background: #1c140d;
    color: #f7f3ed;
    border: 1px solid rgba(201, 160, 80, 0.25);
    border-left: 3px solid hsl(42, 48%, 77%);
}

.ai-msg-bot .ai-msg-bubble strong {
    color: hsl(42, 48%, 77%);
    font-weight: 700;
}

.ai-msg-user .ai-msg-bubble {
    background: hsl(42, 48%, 77%);
    color: #1a1008;
    font-weight: 600;
    border: 1px solid hsl(42, 48%, 77%);
}

.ai-msg-time {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 5px;
    padding: 0 4px;
    letter-spacing: 0.05em;
}

.ai-msg-user .ai-msg-time {
    align-self: flex-end;
    color: hsl(42, 48%, 77%);
}

/* Call to Action Button Inside Chat */
.ai-book-cta {
    display: inline-block;
    margin-top: 14px;
    background: hsl(42, 48%, 77%);
    color: #1a1008 !important;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    padding: 10px 20px;
    border-radius: 3px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
