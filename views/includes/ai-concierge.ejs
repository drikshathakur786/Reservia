<!-- Reservia Fine Dining AI Concierge & Sommelier -->
<div id="ai-concierge-container">
    <!-- Floating Trigger Button (Matches Reservia Creative Header/Button) -->
    <button id="ai-concierge-toggle" aria-label="Open Reservia Concierge">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="ai-btn-star">
            <path d="M12 2L15.5 8.5L22 12L15.5 15.5L12 22L8.5 15.5L2 12L8.5 8.5L12 2Z" fill="hsl(42, 48%, 77%)" />
        </svg>
        <span class="ai-btn-text">RESERVIA CONCIERGE</span>
        <span class="ai-pulse-ring"></span>
    </button>

    <!-- Chat Modal Window -->
    <div id="ai-concierge-modal" class="ai-modal-hidden">
        <!-- Luxury Brand Header -->
        <div class="ai-header">
            <div class="ai-header-info">
                <div class="ai-avatar">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.5 8.5L22 12L15.5 15.5L12 22L8.5 15.5L2 12L8.5 8.5L12 2Z" fill="hsl(42, 48%, 77%)" />
                    </svg>
                </div>
                <div class="ai-brand-titles">
                    <span class="ai-brand-name">RESERVIA</span>
                    <span class="ai-brand-subtitle"><span class="ai-live-indicator"></span> MAÎTRE D' &amp; SOMMELIER</span>
                </div>
            </div>
            <button id="ai-concierge-close" aria-label="Close Concierge">&times;</button>
        </div>

        <!-- Suggestion Chips -->
        <div class="ai-chips-wrapper">
            <button class="ai-chip" data-prompt="What wine pairs best with steak or pasta?">🍷 Wine Pairings</button>
            <button class="ai-chip" data-prompt="Plan a romantic 3-course anniversary dinner for 2.">🕯️ Anniversary Plan</button>
            <button class="ai-chip" data-prompt="What are your vegetarian and gluten-free options?">🥗 Vegan &amp; Dietary</button>
            <button class="ai-chip" data-prompt="What are your operating hours and best reservation times?">⏰ Booking Slots</button>
        </div>

        <!-- Message History -->
        <div class="ai-messages" id="ai-messages-list">
            <div class="ai-msg ai-msg-bot">
                <div class="ai-msg-bubble">
                    Good evening and welcome to <strong>Reservia</strong>. I am your personal <strong>Maître D' &amp; Sommelier</strong>.
                    <br><br>
                    What are you in the mood for tonight? Ask me anything — from wine pairings and chef specials, to dietary advice or planning an intimate celebration.
                </div>
                <span class="ai-msg-time">Just now</span>
            </div>
        </div>

        <!-- Typing Indicator -->
        <div id="ai-typing-indicator" class="ai-typing-hidden">
            <div class="ai-dot"></div>
            <div class="ai-dot"></div>
            <div class="ai-dot"></div>
            <span class="ai-typing-text">Maître D' is curating...</span>
        </div>

        <!-- Input Area -->
        <form id="ai-chat-form" class="ai-input-form">
            <input type="text" id="ai-user-input" placeholder="Ask about wine pairings, menus, occasions..." autocomplete="off" required>
            <button type="submit" id="ai-send-btn" aria-label="Send message">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </form>
    </div>
</div>

<style>
/* Root Container */
#ai-concierge-container {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 99999;
    font-family: 'DM Sans', sans-serif;
}

/* Floating Trigger Button (Matches Reservia .header-book-btn / creative logo aesthetic) */
#ai-concierge-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1a1008;
    color: hsl(42, 48%, 77%);
    border: 1px solid hsl(42, 48%, 77%);
