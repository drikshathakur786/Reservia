}

.ai-book-cta:hover {
    background: #fff;
    color: #1a1008 !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,255,255,0.25);
}

/* Typing Indicator */
#ai-typing-indicator {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 20px 14px;
}

.ai-typing-hidden {
    display: none !important;
}

.ai-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: hsl(42, 48%, 77%);
    animation: ai-bounce 1.4s infinite ease-in-out both;
}

.ai-dot:nth-child(1) { animation-delay: -0.32s; }
.ai-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes ai-bounce {
    0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
    40% { transform: scale(1); opacity: 1; }
}

.ai-typing-text {
    font-size: 0.8rem;
    color: hsl(42, 48%, 77%);
    margin-left: 8px;
    letter-spacing: 0.05em;
    font-style: italic;
}

/* Input Form */
.ai-input-form {
    display: flex;
    align-items: center;
    padding: 14px 18px;
    background: #18110a;
    border-top: 1px solid rgba(201, 160, 80, 0.25);
    gap: 10px;
}

#ai-user-input {
    flex: 1;
    background: #251b11;
    border: 1px solid rgba(201, 160, 80, 0.4);
    border-radius: 3px;
    color: #fff;
    padding: 12px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.98rem;
    outline: none;
    transition: all 0.2s;
}

#ai-user-input:focus {
    border-color: hsl(42, 48%, 77%);
    box-shadow: 0 0 10px rgba(201, 160, 80, 0.25);
}

#ai-send-btn {
    width: 44px;
    height: 44px;
    border-radius: 3px;
    background: hsl(42, 48%, 77%);
    color: #1a1008;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
}

#ai-send-btn:hover {
    background: #fff;
    color: #1a1008;
    transform: scale(1.05);
}
</style>

<script>
(function() {
    var toggleBtn = document.getElementById('ai-concierge-toggle');
    var modal = document.getElementById('ai-concierge-modal');
    var closeBtn = document.getElementById('ai-concierge-close');
    var form = document.getElementById('ai-chat-form');
    var input = document.getElementById('ai-user-input');
    var messagesList = document.getElementById('ai-messages-list');
    var typing = document.getElementById('ai-typing-indicator');

    if (!toggleBtn || !modal) return;

    toggleBtn.addEventListener('click', function() {
        modal.classList.toggle('ai-modal-hidden');
        if (!modal.classList.contains('ai-modal-hidden')) {
            setTimeout(function() { 
                input.focus(); 
                scrollToBottom();
            }, 150);
        }
    });

    closeBtn.addEventListener('click', function() {
        modal.classList.add('ai-modal-hidden');
    });

    // Chip triggers
    document.querySelectorAll('.ai-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
            var prompt = chip.getAttribute('data-prompt');
            if (prompt) {
                sendMessage(prompt);
            }
        });
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        var txt = input.value.trim();
        if (!txt) return;
        sendMessage(txt);
        input.value = '';
    });

    function scrollToBottom() {
        setTimeout(function() {
            messagesList.scrollTop = messagesList.scrollHeight;
        }, 50);
    }

    async function sendMessage(text) {
        appendMessage('user', text);
        typing.classList.remove('ai-typing-hidden');
        scrollToBottom();

        try {
            var res = await fetch('/api/ai/concierge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });
            var data = await res.json();
            typing.classList.add('ai-typing-hidden');
            appendMessage('bot', data.reply);
        } catch(err) {
            typing.classList.add('ai-typing-hidden');
            appendMessage('bot', "Our sommeliers are at your service! For reservations and inquiries, please visit our <a href='/reservation' class='ai-book-cta'>Reservations Page</a> or call <strong>+91 98765 43210</strong>.");
        }
    }

    function appendMessage(sender, htmlContent) {
        var wrapper = document.createElement('div');
        wrapper.className = 'ai-msg ai-msg-' + sender;
        
        var bubble = document.createElement('div');
        bubble.className = 'ai-msg-bubble';
        bubble.innerHTML = htmlContent;

        var time = document.createElement('span');
        time.className = 'ai-msg-time';
        var d = new Date();
        time.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        wrapper.appendChild(bubble);
        wrapper.appendChild(time);
        messagesList.appendChild(wrapper);
        scrollToBottom();
    }
})();
</script>
