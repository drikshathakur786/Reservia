        color: #1a1008;
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        cursor: pointer;
        border-radius: 2px;
        transition: background 0.25s;
    }

    .edit-reservation-form button[type="submit"]:hover {
        background: #c9a96e;
    }

