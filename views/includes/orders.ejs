<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&family=Forum&display=swap');

    /* ── Orders page layout ── */
    .orders-page {
        min-height: 100vh;
        padding: 140px 24px 80px;
        background-color: #0d0d0d;
        background-image:
            radial-gradient(ellipse at top, rgba(166,123,91,0.08) 0%, transparent 55%);
    }

    .orders-page-title {
        font-family: 'Forum', cursive;
        font-size: clamp(2.8rem, 5vw, 5rem);
        font-weight: 400;
        color: #fff;
        text-align: center;
        margin-bottom: 8px;
    }

    .orders-page-subtitle {
        text-align: center;
        font-family: 'DM Sans', sans-serif;
        font-size: 1.2rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.35);
        margin-bottom: 16px;
    }

    .orders-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 52px;
    }

    .orders-divider span {
        width: 60px;
        height: 1px;
        background: rgba(166,123,91,0.35);
    }

    .orders-divider .dot {
        width: 6px;
        height: 6px;
        border: 1px solid hsl(42,48%,77%);
        transform: rotate(45deg);
    }

    /* ── Grid ── */
    .orders-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 28px;
        max-width: 1200px;
        margin: 0 auto;
    }

