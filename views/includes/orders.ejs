    .empty-state {
        text-align: center;
        padding: 80px 20px;
        grid-column: 1 / -1;
    }

    .empty-state p {
        font-family: 'Forum', cursive;
        font-size: 2.4rem;
        color: rgba(255,255,255,0.2);
        margin-bottom: 24px;
    }

    .empty-state a {
        display: inline-block;
        padding: 14px 40px;
        border: 1px solid hsl(42,48%,77%);
