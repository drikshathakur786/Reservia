        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .order-container:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .order-id {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: hsl(42,48%,77%);
        letter-spacing: 0.1em;
    }

    .order-status {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.4);
        max-width: 160px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .order-date {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.35);
    }

    .order-details ul {
        padding: 0;
        margin: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .order-item {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.3rem;
        color: rgba(255,255,255,0.7);
        padding-left: 14px;
        border-left: 2px solid rgba(166,123,91,0.3);
    }

    .order-total-status {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .order-total-status strong {
        font-family: 'Forum', cursive;
        font-size: 2.2rem;
        color: hsl(42,48%,77%);
