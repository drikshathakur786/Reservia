<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&family=Forum&family=Playfair+Display:wght@400;700&display=swap');

    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 120px 20px 60px;
        background-color: #0d0d0d;
        background-image:
            radial-gradient(ellipse at top left, rgba(166,123,91,0.12) 0%, transparent 60%),
            radial-gradient(ellipse at bottom right, rgba(90,62,54,0.18) 0%, transparent 60%);
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        background: rgba(20, 14, 10, 0.95);
        border: 1px solid rgba(166, 123, 91, 0.25);
        border-radius: 4px;
        padding: 52px 44px 44px;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6);
        animation: fadeSlideUp 0.5s ease forwards;
    }

    @keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .auth-brand {
        text-align: center;
        margin-bottom: 36px;
    }

    .auth-brand .r-badge {
        width: 64px;
        height: 64px;
        border: 1px solid rgba(166,123,91,0.5);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        font-family: 'Forum', cursive;
        font-size: 2.8rem;
        color: hsl(42, 48%, 77%);
        animation: spin-slow 20s linear infinite;
    }

    @keyframes spin-slow {
        from { box-shadow: 0 0 0 0 rgba(166,123,91,0); }
        50%  { box-shadow: 0 0 20px 4px rgba(166,123,91,0.15); }
        to   { box-shadow: 0 0 0 0 rgba(166,123,91,0); }
    }

    .auth-brand h1 {
        font-family: 'Forum', cursive;
        font-size: 2.6rem;
        font-weight: 400;
        color: #fff;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .auth-brand p {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.25rem;
        color: rgba(255,255,255,0.45);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin: 0;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 28px 0;
    }
    .auth-divider span {
        flex: 1;
        height: 1px;
        background: rgba(166,123,91,0.2);
    }
    .auth-divider .diamond {
        width: 6px;
        height: 6px;
        border: 1px solid hsl(42,48%,77%);
        transform: rotate(45deg);
        flex: none;
    }

    .auth-label {
        display: block;
        font-family: 'DM Sans', sans-serif;
        font-size: 1.1rem;
        color: rgba(255,255,255,0.5);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 8px;
    }

    .auth-input {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(166,123,91,0.2);
        border-radius: 2px;
        padding: 14px 16px;
        font-family: 'DM Sans', sans-serif;
        font-size: 1.4rem;
        color: #fff;
        transition: border-color 0.3s, box-shadow 0.3s;
        margin-bottom: 22px;
        box-sizing: border-box;
    }

    .auth-input::placeholder {
        color: rgba(255,255,255,0.2);
    }

    .auth-input:focus {
        outline: none;
        border-color: hsl(42,48%,77%);
        box-shadow: 0 0 0 3px rgba(166,123,91,0.12);
    }

    .auth-btn {
        width: 100%;
        padding: 15px;
        background: transparent;
        border: 1px solid hsl(42,48%,77%);
        color: hsl(42,48%,77%);
        font-family: 'DM Sans', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 3px;
        cursor: pointer;
        border-radius: 2px;
        transition: background 0.3s, color 0.3s, transform 0.2s;
        margin-top: 8px;
        position: relative;
        overflow: hidden;
    }

    .auth-btn::before {
        content: '';
        position: absolute;
        top: 0; left: -100%;
        width: 100%; height: 100%;
        background: hsl(42,48%,77%);
        transition: left 0.3s ease;
        z-index: 0;
    }

    .auth-btn span {
        position: relative;
        z-index: 1;
    }

    .auth-btn:hover::before { left: 0; }
    .auth-btn:hover {
        color: #1a1008;
        transform: translateY(-1px);
    }

    .auth-footer {
        text-align: center;
        margin-top: 28px;
        font-family: 'DM Sans', sans-serif;
        font-size: 1.3rem;
        color: rgba(255,255,255,0.4);
    }

    .auth-footer a {
        color: hsl(42,48%,77%);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.3s;
    }

    .auth-footer a:hover {
        border-bottom-color: hsl(42,48%,77%);
    }

    .auth-error {
        background: rgba(220,50,50,0.1);
        border: 1px solid rgba(220,50,50,0.3);
        border-radius: 2px;
        padding: 12px 16px;
        font-family: 'DM Sans', sans-serif;
        font-size: 1.3rem;
        color: #ff8080;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>