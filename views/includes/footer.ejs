    </svg>
    <div class="logo-text" style="text-align: left;">
        <span class="logo-title" style="display:block; font-family: 'Forum', cursive; font-size: 1.8rem; color: #fff; letter-spacing: 0.15em; line-height: 1; margin-bottom: 4px;">RESERVIA</span>
        <span class="logo-sub" style="display:block; font-family: 'DM Sans', sans-serif; font-size: 0.65rem; color: hsl(42, 48%, 77%); letter-spacing: 0.4em; text-transform: uppercase; line-height: 1;">FINE DINING</span>
    </div>
</div>
</a>
<p style = "margin-bottom: 1rem; font-size: 0.9rem;"> 123 Culinary Avenue, Food City </p>
        <p> <a href = "mailto:concierge@reservia.com" style = "text-decoration: none; color: #B8860B;"> concierge@reservia.com </a> </p>
        <p> <a href = "tel:+919876543210" style = "text-decoration: none; color: #B8860B;"> +91 98765 43210 </a> </p>
        <p style = "margin-top: 1rem; font-size: 0.9rem;"> Lunch: 12:00 PM – 3:30 PM <br> Dinner: 6:30 PM – 11:00 PM </p>
</div>

<div>
        <h4 style = "margin-bottom: 1rem; font-size: 1.25rem; color: #B8860B;"> Quick Links </h4>
        <ul style = "list-style: none; padding: 0; line-height: 2;">
        <li> <a href = "/home" style = "text-decoration: none; color: inherit;"> Home </a> </li>
        <li> <a href = "/reservation" style = "text-decoration: none; color: inherit;"> Reservations </a> </li>
        <li> <a href = "/explore" style = "text-decoration: none; color: inherit;"> Restaurants </a> </li>
        <li> <a href = "/about" style = "text-decoration: none; color: inherit;"> About Us </a> </li>
        <li> <a href = "/contact" style = "text-decoration: none; color: inherit;"> Contact </a> </li>
</ul>
</div>

<div>
<h4 style = "margin-bottom: 1rem; font-size: 1.25rem; color: #B8860B;"> Follow Us </h4>
<ul style = "list-style: none; padding: 0; line-height: 2;">
<li> <a href = "#" style = "text-decoration: none; color: inherit;"> Facebook </a> </li>
<li> <a href = "#" style = "text-decoration: none; color: inherit;"> Instagram </a> </li>
<li> <a href = "#" style = "text-decoration: none; color: inherit;"> Twitter </a> </li>
<li> <a href = "#" style = "text-decoration: none; color: inherit;"> YouTube </a> </li>
<li> <a href = "#" style = "text-decoration: none; color: inherit;"> Google Maps </a> </li>
</ul>
</div>

<div>
<h4 style = "margin-bottom: 1rem; font-size: 1.5rem; color: #B8860B;"> Stay Updated </h4>
<p style = "margin-bottom: 1rem; font-size: 1rem;"> Subscribe for tasting invites &amp; exclusive privileges. </p>
<form id = "subscribeForm" action = "/subscribe" method = "POST" style = "display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
<input type = "email" name = "email_address" id = "subscribeEmail" placeholder = "Your email address" required autocomplete = "off" 
style = "
flex: 1; 
min-width: 180px;
padding: 0.8rem; 
border: 1px solid #B8860B; 
background: #3c2b20; 
border-radius: 4px; 
color: #f5f5f5; 
font-size: 0.9rem;
">
<button type = "submit" id = "subscribeBtn" style = "
padding: 0.8rem 1.2rem; 
background-color: #B8860B; 
border: none; 
border-radius: 4px; 
font-size: 0.9rem; 
font-weight: bold; 
cursor: pointer; 
color: #2e1e14;
">
Subscribe
</button>
</form>
<p id = "subscribeMsg" style = "display: none; margin-top: 0.8rem; font-size: 0.85rem; line-height: 1.4;"></p>
</div>
</div>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script>
    (function() {
        if (typeof emailjs !== 'undefined') {
            emailjs.init({ publicKey: "KdhXcMwodUaRyQXOA" });
        }
        var sf = document.getElementById('subscribeForm');
        if (sf) {
            sf.addEventListener('submit', async function(e) {
                e.preventDefault();
                var btn = document.getElementById('subscribeBtn');
                var msg = document.getElementById('subscribeMsg');
                var inp = document.getElementById('subscribeEmail');
                var emailVal = (inp.value || '').trim();
                btn.disabled = true;
                btn.textContent = 'Subscribing...';
                try {
                    // 1. Send email directly from browser via EmailJS (bypasses Render SMTP port blocking)
                    if (typeof emailjs !== 'undefined') {
                        emailjs.send("service_wvfb7pe", "template_r5h7qmm", { email: emailVal });
                    }

                    // 2. Save subscriber in backend database
                    var r = await fetch('/subscribe', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ email: emailVal })
                    });
                    var d = await r.json();
                    msg.style.display = 'block';
                    msg.style.color = '#4ade80';
                    msg.textContent = d.message || 'Welcome to Reservia! A confirmation email has been dispatched.';
                    inp.value = '';
                } catch(err) {
                    msg.style.display = 'block';
                    msg.style.color = '#f87171';
                    msg.textContent = 'Subscription error. Please try again.';
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Subscribe';
                }
            });
        }
    })();
</script>
</div>

<div class = "footer-bottom" style = "
margin-top: 2rem; 
text-align: center; 
font-size: 1.3rem; 
border-top: 1px solid rgba(255, 255, 255, 0.2); 
padding-top: 1rem;
">
&copy; <%= new Date().getFullYear() %> Reservia. All Rights Reserved.
</div>
</div>
</footer>
